# Clerk (https://dashboard.clerk.com). The secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity (https://www.sanity.io/manage). The dataset is private.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-25
# Viewer-role token, server-only. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# PostHog (https://posthog.com). The project key is public by design.
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com, matching your project's region
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
